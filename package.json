{
  "name": "manuscript-workbench-dev",
  "private": true,
  "description": "Development tooling only (JS tests, lint, format). The app itself has no npm dependencies.",
  "scripts": {
    "test": "node --test tests/js/",
    "lint": "eslint static tests",
    "format": "prettier --write \"static/js/**/*.js\"",
    "format:check": "prettier --check \"static/js/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
