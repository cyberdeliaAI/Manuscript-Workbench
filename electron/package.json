{
  "name": "manuscript-workbench-desktop",
  "productName": "Manuscript Workbench",
  "version": "2.0.0",
  "description": "Manuscript Workbench in its own desktop window.",
  "author": "Cyberdelia",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "nl.cyberdelia.manuscriptworkbench",
    "asar": true,
    "directories": {
      "output": "out"
    },
    "files": [
      "*.cjs",
      "!harden.cjs",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/desktop/backend/manuscript-workbench-server",
        "to": "backend"
      },
      {
        "from": "../assets/icon-512.png",
        "to": "icon.png"
      }
    ],
    "afterPack": "./harden.cjs",
    "artifactName": "manuscript-workbench-desktop-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "../assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "../assets/icon.png"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "executableName": "manuscript-workbench",
      "icon": "../assets/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
